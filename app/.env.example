# Copy to .env.local and fill in. Never commit real keys.
#
# Two places read these values:
#   1. Next.js and local scripts read .env.local (the NEXT_PUBLIC_* values and
#      E2B_API_KEY for `npm run template:build:*`).
#   2. Convex functions run on Convex's servers and read the deployment's own
#      environment. Set every "Convex" value below there too:
#        npx convex env set GEMINI_API_KEY <value>          (dev deployment)
#        npx convex env set GEMINI_API_KEY <value> --prod   (production)

# --- Convex (written by `npx convex dev` on first run) -----------------------
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Production only (Vercel): deploy key from the Convex dashboard's project
# settings. Not needed for local development.
# CONVEX_DEPLOY_KEY=prod:your-deployment-name|...

# --- Gemini (Convex) ---------------------------------------------------------
# API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for answers, titles and follow-up suggestions.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Datatrove dataset search (Convex) ---------------------------------------
# Hawaiʻi open-data index the agent searches. No key needed.
DATATROVE_API_URL=https://api.datatrove.ai

# --- U.S. Census Bureau Data API (Convex) ------------------------------------
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- E2B Python sandbox (Convex + local template builds) ---------------------
# API key from https://e2b.dev/dashboard
E2B_API_KEY=
# Sandbox template built by `npm run template:build:dev` (or :prod):
#   code-interpreter-v1-plus-geo-dev  (dev)   code-interpreter-v1-plus-geo  (prod)
E2B_TEMPLATE_ID=code-interpreter-v1-plus-geo-dev
